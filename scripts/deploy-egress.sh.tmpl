set -euo pipefail

# Deploy egress proxy for a single agent.
# Called by the CLI's policy deploy flow — config is pre-generated in Go.
AGENT_NAME="{{.AgentName}}"
EGRESS_MODE="{{.Mode}}"

# Validate agent name format (防 sed/iptables metacharacter injection)
if ! echo "$AGENT_NAME" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
  echo "ERROR: Invalid agent name '$AGENT_NAME' — must match [a-z0-9][a-z0-9-]*"
  exit 1
fi
EGRESS_CONF="/opt/conga/config/egress-$AGENT_NAME.yaml"
EGRESS_PROXY="conga-egress-$AGENT_NAME"
AGENT_NET="conga-$AGENT_NAME"

# Write policy file to host (idempotent)
cat > /opt/conga/conga-policy.yaml << 'POLICYEOF'
{{.PolicyContent}}
POLICYEOF
chmod 0444 /opt/conga/conga-policy.yaml

# Write pre-generated Envoy config
mkdir -p "$(dirname "$EGRESS_CONF")"
cat > "$EGRESS_CONF" << 'ENVOYEOF'
{{.EnvoyConfig}}
ENVOYEOF
chmod 0444 "$EGRESS_CONF"

# Write deployment manifest alongside the Envoy config so drift detection
# (conga policy drift) can compare the running proxy's config to the current
# desired policy without parsing Lua out of the YAML.
EGRESS_MANIFEST="/opt/conga/config/egress-$AGENT_NAME.manifest.json"
cat > "$EGRESS_MANIFEST" << 'MANIFESTEOF'
{{.ManifestJSON}}
MANIFESTEOF
chmod 0444 "$EGRESS_MANIFEST"

# Write proxy bootstrap JS (patches Node.js fetch/https to route through proxy)
BOOTSTRAP_PATH="/opt/conga/config/proxy-bootstrap.js"
cat > "$BOOTSTRAP_PATH" << 'BOOTSTRAPEOF'
{{.ProxyBootstrapJS}}
BOOTSTRAPEOF
chmod 0444 "$BOOTSTRAP_PATH"

# Write mode marker for systemd hooks
echo "$EGRESS_MODE" > "/opt/conga/config/egress-$AGENT_NAME.mode"

# Build proxy image if not present
if ! docker image inspect conga-egress-proxy >/dev/null 2>&1; then
  echo "Building egress proxy image..."
  mkdir -p /tmp/conga-egress-build
  cat > /tmp/conga-egress-build/Dockerfile << 'PROXYDF'
FROM envoyproxy/envoy:v1.32-latest
PROXYDF
  trap 'rm -rf /tmp/conga-egress-build' EXIT
  docker build -t conga-egress-proxy /tmp/conga-egress-build
  rm -rf /tmp/conga-egress-build
  trap - EXIT
fi

# Stop existing proxy if running (recreated below with the current Envoy config)
docker rm -f "$EGRESS_PROXY" 2>/dev/null || true

# NOTE: egress iptables are owned by the agent's systemd unit — deterministic
# static-IP DROP/RETURN rules in its ExecStartPost/ExecStopPost (managed-host
# engine, audit #7). The `systemctl restart` below cycles them (ExecStopPost
# removes, ExecStartPost re-adds), so deploy-egress no longer discovers the
# container IP or touches iptables directly. That retired the 10-retry
# docker-inspect discovery loop and the orphaned port-53 rules it used to leave.

# Verify config was written
if [ ! -f "$EGRESS_CONF" ]; then
  echo "ERROR: egress config not found at $EGRESS_CONF"
  ls -la /opt/conga/config/egress-* 2>/dev/null || echo "No egress configs found"
  exit 1
fi
echo "Config file: $(ls -la "$EGRESS_CONF")"

# Start egress proxy container. Pin the proxy to its reserved static IP ({{.ProxyIP}})
# so a simultaneous restart (reboot / docker daemon restart) can't let this
# --restart-always proxy grab the agent's .2 before the agent does (exit-125
# crash-loop). The agent binds .2, the proxy binds .3 — deterministic either order.
docker run -d \
  --name "$EGRESS_PROXY" \
  --network "$AGENT_NET" \
  --ip "{{.ProxyIP}}" \
  --restart always \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 128m \
  --user 101:101 \
  --entrypoint /usr/local/bin/envoy \
  -v "$EGRESS_CONF:/etc/envoy/envoy.yaml:ro" \
  conga-egress-proxy \
  -c /etc/envoy/envoy.yaml --log-level warn

# Verify proxy is running (retry to allow for slow starts on loaded hosts)
for i in $(seq 1 5); do
  if docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
    break
  fi
  sleep 1
done
if ! docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
  echo "ERROR: Egress proxy $EGRESS_PROXY failed to start — check config"
  docker logs "$EGRESS_PROXY" 2>&1 | tail -20 || true
  exit 1
fi
echo "Egress proxy started for $AGENT_NAME (mode=$EGRESS_MODE)"

# Verify the agent is provisioned (the systemd unit must exist). The agent's
# HTTPS_PROXY/HTTP_PROXY/NO_PROXY env, the proxy-bootstrap mount, and the
# NODE_OPTIONS --require are baked into the Go-generated unit (managed-host
# engine, B-2) — deploy-egress no longer `sed`-injects the unit (audit #8).
UNIT_FILE="/etc/systemd/system/conga-$AGENT_NAME.service"
if [ ! -f "$UNIT_FILE" ]; then
  echo "ERROR: systemd unit $UNIT_FILE not found — agent $AGENT_NAME may not be provisioned"
  exit 1
fi

# Restart the agent so it picks up the freshly-recreated proxy. The restart
# deterministically cycles the unit's egress iptables (ExecStopPost removes,
# ExecStartPost re-adds the static-IP rules) — always enforced, in every mode.
# No router bridge attach: the router runs --network host and reaches the agent
# via 127.0.0.1:<hostPort> (loopback topology).
systemctl restart "conga-$AGENT_NAME"
echo "Agent container restarted (egress iptables cycled via the systemd unit)"

echo "Egress policy deployed for $AGENT_NAME (mode=$EGRESS_MODE)"
