set -euo pipefail
umask 077
AGENT_NAME="{{.AgentName}}"
SLACK_CHANNEL="{{.SlackChannel}}"
AWS_REGION="{{.AWSRegion}}"
GATEWAY_PORT="{{.GatewayPort}}"

get_secret() {
  aws secretsmanager get-secret-value \
    --secret-id "$1" --query SecretString --output text --region "$AWS_REGION"
}

CONGA_IMAGE=$(aws ssm get-parameter --name "/conga/config/image" \
  --query "Parameter.Value" --output text --region "$AWS_REGION")

echo "=== Setting up team agent: $AGENT_NAME ==="

SLACK_BOT_TOKEN=$(get_secret "conga/shared/slack-bot-token")
SLACK_SIGNING_SECRET=$(get_secret "conga/shared/slack-signing-secret")
GOOGLE_CLIENT_ID=$(get_secret "conga/shared/google-client-id")
GOOGLE_CLIENT_SECRET=$(get_secret "conga/shared/google-client-secret")

# Discover per-agent secrets
AGENT_SECRET_NAMES=$(aws secretsmanager list-secrets \
  --filter Key=name,Values="conga/agents/$AGENT_NAME/" \
  --query 'SecretList[].Name' --output text \
  --region "$AWS_REGION" 2>/dev/null || echo "")

cat > /opt/conga/config/$AGENT_NAME.env << ENVFILE
SLACK_BOT_TOKEN=$SLACK_BOT_TOKEN
SLACK_SIGNING_SECRET=$SLACK_SIGNING_SECRET
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
ENVFILE

if [ -n "$AGENT_SECRET_NAMES" ]; then
  for SECRET_PATH in $AGENT_SECRET_NAMES; do
    SECRET_VALUE=$(get_secret "$SECRET_PATH")
    SECRET_NAME=$(echo "$SECRET_PATH" | sed "s|conga/agents/$AGENT_NAME/||" | tr '[:lower:]-' '[:upper:]_')
    echo "$SECRET_NAME=$SECRET_VALUE" >> /opt/conga/config/$AGENT_NAME.env
  done
fi
chmod 0400 /opt/conga/config/$AGENT_NAME.env

# openclaw.json, the $include layers, the integrity baseline, and the agent's
# gateway token are NOT generated here anymore. ProvisionAgent calls RefreshAgent
# after this infra script; RefreshAgent's regenerateAgentConfigOnInstance generates
# openclaw.json + env in Go (canonical model + per-agent agent.yaml overlay — the
# old static heredoc honored neither), seeds the $include layers + baselines, and
# refresh-user.sh writes the systemd unit + starts the container + applies egress
# iptables. This script now only prepares per-agent infrastructure. See
# pkg/provider/managedhost + slice 2 of
# specs/2026-06-13_feature_managed-host-provisioning-engine/.

mkdir -p /opt/conga/data/$AGENT_NAME/data/{workspace,memory,logs,agents,canvas,cron,devices,identity,media}
chown -R 1000:1000 /opt/conga/data/$AGENT_NAME

# Store agent metadata for behavior deployment
echo "team" > /opt/conga/config/$AGENT_NAME.type
echo "$SLACK_CHANNEL" > /opt/conga/config/$AGENT_NAME.slack-id

# Sync and deploy behavior files
aws s3 sync "s3://{{.StateBucket}}/conga/agents/" /opt/conga/agents/ --region "$AWS_REGION" 2>/dev/null || true
if [ -x /opt/conga/bin/deploy-agents.sh ]; then
  /opt/conga/bin/deploy-agents.sh "$AGENT_NAME" "team"
else
  # deploy-agents.sh unavailable: it normally creates the #31 managed $include
  # targets (fleet-custom.json + agent-managed-custom.json) from synced sources.
  # A missing $include target invalidates the whole OpenClaw config, so seed them
  # as "{}" here (root:root 0444) to keep the config loadable.
  for MF in fleet-custom.json agent-managed-custom.json; do
    [ -e /opt/conga/data/$AGENT_NAME/$MF ] || printf '{}\n' > /opt/conga/data/$AGENT_NAME/$MF
    chown root:root /opt/conga/data/$AGENT_NAME/$MF
    chmod 0444 /opt/conga/data/$AGENT_NAME/$MF
  done
fi

# Create the per-agent network with its deterministic static subnet ({{.SubnetCIDR}})
# so the agent (.2) and egress proxy (.3) can bind fixed IPs — the proxy pin below
# requires the static subnet to exist. For a fresh agent this creates it up front
# (no migration churn). If the network ALREADY EXISTS (a re-provision, or a legacy
# auto-subnet agent), `create` fails — bail with an actionable message rather than
# proceeding to pin the proxy on a possibly-non-static subnet (which would exit-125).
# Migrating an existing agent is `conga refresh`'s job (it runs the network reconcile
# first); add-team is for NEW agents.
if ! docker network create --driver bridge --subnet "{{.SubnetCIDR}}" --gateway "{{.GatewayIP}}" "conga-$AGENT_NAME" 2>/dev/null; then
  echo "ERROR: network conga-$AGENT_NAME already exists — this agent is not new. Run 'conga refresh $AGENT_NAME' to (re)apply config + migrate its network; do not re-provision via add-team." >&2
  exit 1
fi

# Deploy egress proxy (deny-all when no policy, enforce by default)
EGRESS_MODE="{{.EgressMode}}"
EGRESS_CONF="/opt/conga/config/egress-$AGENT_NAME.yaml"
EGRESS_PROXY="conga-egress-$AGENT_NAME"
BOOTSTRAP_PATH="/opt/conga/config/proxy-bootstrap.js"

cat > "$EGRESS_CONF" << 'ENVOYEOF'
{{.EnvoyConfig}}
ENVOYEOF
chmod 0444 "$EGRESS_CONF"

cat > "$BOOTSTRAP_PATH" << 'BOOTSTRAPEOF'
{{.ProxyBootstrapJS}}
BOOTSTRAPEOF
chmod 0444 "$BOOTSTRAP_PATH"

echo "$EGRESS_MODE" > "/opt/conga/config/egress-$AGENT_NAME.mode"

if ! docker image inspect conga-egress-proxy >/dev/null 2>&1; then
  echo "Building egress proxy image..."
  mkdir -p /tmp/conga-egress-build
  cat > /tmp/conga-egress-build/Dockerfile << 'PROXYDF'
FROM envoyproxy/envoy:v1.32-latest
PROXYDF
  docker build -t conga-egress-proxy /tmp/conga-egress-build
  rm -rf /tmp/conga-egress-build
fi

docker rm -f "$EGRESS_PROXY" 2>/dev/null || true
docker run -d \
  --name "$EGRESS_PROXY" \
  --network "conga-$AGENT_NAME" \
  --ip "{{.ProxyIP}}" \
  --restart always \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 128m \
  --user 101:101 \
  --entrypoint /usr/local/bin/envoy \
  -v "$EGRESS_CONF:/etc/envoy/envoy.yaml:ro" \
  conga-egress-proxy \
  -c /etc/envoy/envoy.yaml --log-level warn

# Verify proxy started
for i in $(seq 1 5); do
  if docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
    break
  fi
  sleep 1
done
if ! docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
  echo "FATAL: Egress proxy $EGRESS_PROXY failed to start"
  docker logs "$EGRESS_PROXY" 2>&1 | tail -20 || true
  exit 1
fi
echo "Egress proxy started for $AGENT_NAME (mode=$EGRESS_MODE)"

# The systemd unit, container start, and egress iptables are NOT written here.
# ProvisionAgent calls RefreshAgent after this script: regenerateAgentConfigOnInstance
# puts openclaw.json + env on disk (Go), then refresh-user.sh writes the unit (with
# the ExecStartPost/ExecStopPost iptables lifecycle), starts the container, and
# reconciles loopback routing.json + restarts the router. Keeping unit/start/iptables
# in one place (refresh-user.sh) removes the divergent add-path copy (audit #8) and
# the bridge attach. See slice 2 of
# specs/2026-06-13_feature_managed-host-provisioning-engine/.

# Update CloudWatch dashboard with all agents
/opt/conga/bin/update-dashboard.sh || echo "WARNING: Dashboard update failed"

echo "=== Team agent $AGENT_NAME setup complete ==="
