set -euo pipefail
umask 077
AGENT_NAME="{{.AgentName}}"
SLACK_MEMBER_ID="{{.SlackMemberID}}"
AWS_REGION="{{.AWSRegion}}"
GATEWAY_PORT="{{.GatewayPort}}"

get_secret() {
  aws secretsmanager get-secret-value \
    --secret-id "$1" --query SecretString --output text --region "$AWS_REGION"
}

CONGA_IMAGE=$(aws ssm get-parameter --name "/conga/config/image" \
  --query "Parameter.Value" --output text --region "$AWS_REGION")

echo "=== Setting up user agent: $AGENT_NAME ==="

SLACK_BOT_TOKEN=$(get_secret "conga/shared/slack-bot-token")
SLACK_SIGNING_SECRET=$(get_secret "conga/shared/slack-signing-secret")
GOOGLE_CLIENT_ID=$(get_secret "conga/shared/google-client-id")
GOOGLE_CLIENT_SECRET=$(get_secret "conga/shared/google-client-secret")

# Discover per-agent secrets
AGENT_SECRET_NAMES=$(aws secretsmanager list-secrets \
  --filter Key=name,Values="conga/agents/$AGENT_NAME/" \
  --query 'SecretList[].Name' --output text \
  --region "$AWS_REGION" 2>/dev/null || echo "")

cat > /opt/conga/config/$AGENT_NAME.env << ENVFILE
SLACK_BOT_TOKEN=$SLACK_BOT_TOKEN
SLACK_SIGNING_SECRET=$SLACK_SIGNING_SECRET
GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
ENVFILE

if [ -n "$AGENT_SECRET_NAMES" ]; then
  for SECRET_PATH in $AGENT_SECRET_NAMES; do
    SECRET_VALUE=$(get_secret "$SECRET_PATH")
    SECRET_NAME=$(echo "$SECRET_PATH" | sed "s|conga/agents/$AGENT_NAME/||" | tr '[:lower:]-' '[:upper:]_')
    echo "$SECRET_NAME=$SECRET_VALUE" >> /opt/conga/config/$AGENT_NAME.env
  done
fi
chmod 0400 /opt/conga/config/$AGENT_NAME.env

# Generate gateway auth token (OpenClaw v2026.3.22+ refuses to bind a
# non-loopback gateway without auth). 32 random bytes → 64 hex chars.
GATEWAY_TOKEN=$(openssl rand -hex 32)

cat > /opt/conga/config/$AGENT_NAME-config.json << OCCONFIG
{
  "agents": {
    "defaults": {
      "model": { "primary": "anthropic/claude-opus-4-8", "fallbacks": [] },
      "models": { "anthropic/claude-opus-4-8": { "params": {} } },
      "workspace": "/home/node/.openclaw/data/workspace",
      "heartbeat": {
        "every": "55m",
        "lightContext": true,
        "target": "none"
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "5m"
      },
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "tools": { "profile": "coding" },
  "commands": { "native": "auto", "nativeSkills": "auto", "restart": true, "ownerDisplay": "raw" },
  "session": { "dmScope": "per-channel-peer" },
  "hooks": {
    "internal": {
      "enabled": true,
      "entries": {
        "command-logger": { "enabled": true },
        "session-memory": { "enabled": true }
      }
    }
  },
  "channels": {
    "slack": {
      "mode": "http",
      "enabled": true,
      "botToken": "$SLACK_BOT_TOKEN",
      "signingSecret": "$SLACK_SIGNING_SECRET",
      "webhookPath": "/slack/events",
      "userTokenReadOnly": true,
      "groupPolicy": "disabled",
      "dmPolicy": "allowlist",
      "allowFrom": ["$SLACK_MEMBER_ID"],
      "dm": { "enabled": true },
      "streaming": { "mode": "partial", "nativeTransport": true }
    }
  },
  "gateway": { "port": 18789, "mode": "local", "bind": "lan", "auth": { "mode": "token", "token": "$GATEWAY_TOKEN" }, "controlUi": { "allowedOrigins": ["http://localhost:18789", "http://localhost:${GATEWAY_PORT}"] } },
  "skills": { "install": { "nodeManager": "pnpm" } },
  "plugins": { "entries": { "slack": { "enabled": true } } },
  "update": { "checkOnStart": false, "auto": { "enabled": false } }
}
OCCONFIG

mkdir -p /opt/conga/data/$AGENT_NAME/data/{workspace,memory,logs,agents,canvas,cron,devices,identity,media}
chown -R 1000:1000 /opt/conga/data/$AGENT_NAME
cp /opt/conga/config/$AGENT_NAME-config.json /opt/conga/data/$AGENT_NAME/openclaw.json
# Reference the layered custom-config includes ($include array, feature #31).
# OpenClaw merges them under this managed root in array order (later wins), and
# the root wins over every include. Effective precedence:
# root > agent-custom (admin drift) > agent-managed (per-agent) > fleet.
# A missing $include target invalidates the whole config, so all three files must
# exist: deploy-agents.sh creates fleet-custom.json + agent-managed-custom.json
# (from S3-synced sources or "{}"); agent-custom.json is ensured below. root:root
# 0444 keeps them read-only to the agent (uid 1000) — which still reads them for
# $include resolution — so a prompt-injected agent can't inject a channel binding;
# admins edit agent-custom.json via SSM as root. Never clobber existing admin content.
jq '. + {"$include": ["fleet-custom.json", "agent-managed-custom.json", "agent-custom.json"]}' /opt/conga/data/$AGENT_NAME/openclaw.json > /opt/conga/data/$AGENT_NAME/openclaw.json.tmp \
  && mv /opt/conga/data/$AGENT_NAME/openclaw.json.tmp /opt/conga/data/$AGENT_NAME/openclaw.json
chown 1000:1000 /opt/conga/data/$AGENT_NAME/openclaw.json
[ -e /opt/conga/data/$AGENT_NAME/agent-custom.json ] || printf '{}\n' > /opt/conga/data/$AGENT_NAME/agent-custom.json
chown root:root /opt/conga/data/$AGENT_NAME/agent-custom.json
chmod 0444 /opt/conga/data/$AGENT_NAME/agent-custom.json

# Config hash baseline — hash the deployed openclaw.json (post-$include) so the
# periodic integrity check matches what the agent actually loads.
sha256sum /opt/conga/data/$AGENT_NAME/openclaw.json | cut -d' ' -f1 > /opt/conga/config/$AGENT_NAME-config.json.sha256
chmod 0444 /opt/conga/config/$AGENT_NAME-config.json.sha256

# Store agent metadata for behavior deployment
echo "user" > /opt/conga/config/$AGENT_NAME.type
echo "$SLACK_MEMBER_ID" > /opt/conga/config/$AGENT_NAME.slack-id

# Sync and deploy behavior files
aws s3 sync "s3://{{.StateBucket}}/conga/agents/" /opt/conga/agents/ --region "$AWS_REGION" 2>/dev/null || true
if [ -x /opt/conga/bin/deploy-agents.sh ]; then
  /opt/conga/bin/deploy-agents.sh "$AGENT_NAME" "user"
else
  # deploy-agents.sh unavailable: it normally creates the #31 managed $include
  # targets (fleet-custom.json + agent-managed-custom.json) from synced sources.
  # A missing $include target invalidates the whole OpenClaw config, so seed them
  # as "{}" here (root:root 0444) to keep the config loadable.
  for MF in fleet-custom.json agent-managed-custom.json; do
    [ -e /opt/conga/data/$AGENT_NAME/$MF ] || printf '{}\n' > /opt/conga/data/$AGENT_NAME/$MF
    chown root:root /opt/conga/data/$AGENT_NAME/$MF
    chmod 0444 /opt/conga/data/$AGENT_NAME/$MF
  done
fi

docker network create --driver bridge "conga-$AGENT_NAME" || true

# Deploy egress proxy (deny-all when no policy, enforce by default)
EGRESS_MODE="{{.EgressMode}}"
EGRESS_CONF="/opt/conga/config/egress-$AGENT_NAME.yaml"
EGRESS_PROXY="conga-egress-$AGENT_NAME"
BOOTSTRAP_PATH="/opt/conga/config/proxy-bootstrap.js"

cat > "$EGRESS_CONF" << 'ENVOYEOF'
{{.EnvoyConfig}}
ENVOYEOF
chmod 0444 "$EGRESS_CONF"

cat > "$BOOTSTRAP_PATH" << 'BOOTSTRAPEOF'
{{.ProxyBootstrapJS}}
BOOTSTRAPEOF
chmod 0444 "$BOOTSTRAP_PATH"

echo "$EGRESS_MODE" > "/opt/conga/config/egress-$AGENT_NAME.mode"

if ! docker image inspect conga-egress-proxy >/dev/null 2>&1; then
  echo "Building egress proxy image..."
  mkdir -p /tmp/conga-egress-build
  cat > /tmp/conga-egress-build/Dockerfile << 'PROXYDF'
FROM envoyproxy/envoy:v1.32-latest
PROXYDF
  docker build -t conga-egress-proxy /tmp/conga-egress-build
  rm -rf /tmp/conga-egress-build
fi

docker rm -f "$EGRESS_PROXY" 2>/dev/null || true
docker run -d \
  --name "$EGRESS_PROXY" \
  --network "conga-$AGENT_NAME" \
  --restart always \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  --memory 128m \
  --user 101:101 \
  --entrypoint /usr/local/bin/envoy \
  -v "$EGRESS_CONF:/etc/envoy/envoy.yaml:ro" \
  conga-egress-proxy \
  -c /etc/envoy/envoy.yaml --log-level warn

# Verify proxy started
for i in $(seq 1 5); do
  if docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
    break
  fi
  sleep 1
done
if ! docker inspect -f '{{`{{.State.Running}}`}}' "$EGRESS_PROXY" 2>/dev/null | grep -q true; then
  echo "FATAL: Egress proxy $EGRESS_PROXY failed to start"
  docker logs "$EGRESS_PROXY" 2>&1 | tail -20 || true
  exit 1
fi
echo "Egress proxy started for $AGENT_NAME (mode=$EGRESS_MODE)"

ENV_FLAGS=""
while IFS="=" read -r key value; do
  [ -n "$key" ] && ENV_FLAGS="$ENV_FLAGS -e $key"
done < /opt/conga/config/$AGENT_NAME.env

cat > /etc/systemd/system/conga-$AGENT_NAME.service << UNIT
[Unit]
Description=OpenClaw Gateway ($AGENT_NAME)
After=docker.service conga-router.service
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/conga/config/$AGENT_NAME.env
ExecStartPre=-/usr/bin/docker rm -f conga-$AGENT_NAME
# Seed @openclaw/slack plugin into the agent's data dir before the persistent
# container starts (v2026.5.x extracted Slack into an external plugin).
# Idempotent: errors with "plugin already exists" on subsequent starts; the
# leading "-" tolerates that (already-installed is the desired end state).
ExecStartPre=-/usr/bin/docker run --rm --user 1000:1000 -v /opt/conga/data/$AGENT_NAME:/home/node/.openclaw:rw $CONGA_IMAGE openclaw plugins install @openclaw/slack
ExecStart=/usr/bin/docker run --name conga-$AGENT_NAME --network conga-$AGENT_NAME -p 127.0.0.1:${GATEWAY_PORT}:18789 --cap-drop ALL --security-opt no-new-privileges --memory 2g -e NODE_OPTIONS="--max-old-space-size=1536 --require /opt/proxy-bootstrap.js" -e HTTPS_PROXY=http://$EGRESS_PROXY:3128 -e HTTP_PROXY=http://$EGRESS_PROXY:3128 -e NO_PROXY=localhost,127.0.0.1 --pids-limit 256 --user 1000:1000 -v /opt/conga/data/$AGENT_NAME:/home/node/.openclaw:rw -v $BOOTSTRAP_PATH:/opt/proxy-bootstrap.js:ro $ENV_FLAGS $CONGA_IMAGE
ExecStop=/usr/bin/docker stop conga-$AGENT_NAME
StandardOutput=append:/var/log/conga-$AGENT_NAME.log
StandardError=append:/var/log/conga-$AGENT_NAME.log
Restart=always
RestartSec=10
TimeoutStartSec=120
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable conga-$AGENT_NAME.service
systemctl start conga-$AGENT_NAME.service

# Apply iptables egress rules — always applied (validate mode: proxy logs+allows,
# but iptables ensures nothing bypasses the proxy).
for i in $(seq 1 10); do
  AGENT_IP=$(docker inspect -f "{{`{{(index .NetworkSettings.Networks \"conga-$AGENT_NAME\").IPAddress}}`}}" "conga-$AGENT_NAME" 2>/dev/null || echo "")
  [ -n "$AGENT_IP" ] && break
  sleep 1
done
NET_CIDR=$(docker network inspect -f '{{`{{range .IPAM.Config}}{{.Subnet}}{{end}}`}}' "conga-$AGENT_NAME" 2>/dev/null || echo "")
if [ -n "$AGENT_IP" ] && [ -n "$NET_CIDR" ]; then
  iptables -C DOCKER-USER -s "$AGENT_IP" -j DROP 2>/dev/null || \
    iptables -I DOCKER-USER -s "$AGENT_IP" -j DROP
  iptables -C DOCKER-USER -s "$AGENT_IP" -d "$NET_CIDR" -j RETURN 2>/dev/null || \
    iptables -I DOCKER-USER -s "$AGENT_IP" -d "$NET_CIDR" -j RETURN
  iptables -C DOCKER-USER -s "$AGENT_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN 2>/dev/null || \
    iptables -I DOCKER-USER -s "$AGENT_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
  echo "Egress iptables: DROP rules applied for $AGENT_NAME ($AGENT_IP)"
else
  echo "ERROR: Could not apply egress iptables rules — container IP ($AGENT_IP) or subnet ($NET_CIDR) not found"
  exit 1
fi

# routing.json is generated in Go (loopback form) and the router is restarted by
# ProvisionAgent after this script returns — see pkg/provider/managedhost +
# AWSProvider.regenerateRoutingOnInstance/restartRouterOnInstance. The router runs
# --network host and reaches each agent via 127.0.0.1:<hostPort>, so there is no
# per-agent bridge attach here (that broke on Docker 25 + kernel 6.1.174 — see
# specs/2026-06-11_bugfix_router-host-networking/).

# Update CloudWatch dashboard with all agents
/opt/conga/bin/update-dashboard.sh || echo "WARNING: Dashboard update failed"

echo "=== User agent $AGENT_NAME setup complete ==="
