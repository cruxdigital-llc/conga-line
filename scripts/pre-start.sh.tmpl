#!/bin/bash
# pre-start.sh — ExecStartPre helper for agent systemd units.
# Syncs behavior files from S3 and deploys them to the agent's workspace.
# Called before each container start to ensure behavior files are current.
#
# Usage: /opt/conga/bin/pre-start.sh <agent_name> <aws_region> <state_bucket>
#   state_bucket: S3 bucket name (optional — looked up from SSM if omitted)
set -euo pipefail

AGENT_NAME="$1"
AWS_REGION="${2:-us-east-2}"
STATE_BUCKET="${3:-}"

if [ -z "$STATE_BUCKET" ]; then
  STATE_BUCKET=$(aws ssm get-parameter --name /conga/config/state-bucket --query Parameter.Value --output text --region "$AWS_REGION" 2>/dev/null || echo "")
fi

if [ -z "$STATE_BUCKET" ]; then
  echo "WARNING: could not determine state bucket — skipping behavior sync" >&2
  exit 0
fi

# Serialize the S3 sync + deploy across agents via a host-wide flock. A simultaneous
# fleet start (host reboot / docker daemon restart) otherwise runs N concurrent
# `aws s3 sync`s in parallel ExecStartPre's, which contend and blow the unit's
# TimeoutStartSec → start-pre timeout crash-loop (managed-host migration hardening,
# R4). Serialized, each sync runs solo and fast. The wait is BOUNDED (-w 240, below
# TimeoutStartSec=300) so a stuck holder can't deadlock the whole fleet; on a
# lock-timeout we proceed with the on-disk behavior (the sync is a best-effort
# refresh, not a start gate). The lock releases when this script exits (fd 9 closes).
# Open the lock fd defensively: a failed redirect under `set -e` would otherwise
# abort ExecStartPre (the opposite of this block's fail-soft intent).
exec 9>/var/lock/conga-prestart.lock 2>/dev/null || true
flock -w 240 9 2>/dev/null || echo "WARNING: conga-prestart lock unavailable/timed out; proceeding with on-disk behavior" >&2

# Sync behavior files from S3
aws s3 sync "s3://$STATE_BUCKET/conga/agents/" /opt/conga/agents/ --region "$AWS_REGION" 2>/dev/null || true

# Update the deploy helper itself
aws s3 cp "s3://$STATE_BUCKET/conga/scripts/deploy-agents.sh" /opt/conga/bin/deploy-agents.sh --region "$AWS_REGION" 2>/dev/null || true
chmod +x /opt/conga/bin/deploy-agents.sh 2>/dev/null || true

# Deploy behavior files to the agent's workspace
AGENT_TYPE=$(cat "/opt/conga/config/$AGENT_NAME.type" 2>/dev/null || echo "user")
AGENT_RUNTIME=$(cat "/opt/conga/config/$AGENT_NAME.runtime" 2>/dev/null || echo "openclaw")
/opt/conga/bin/deploy-agents.sh "$AGENT_NAME" "$AGENT_TYPE" "$AGENT_RUNTIME" 2>/dev/null || true

# Fix ownership — workspace uid depends on runtime
if [ "$AGENT_RUNTIME" = "hermes" ]; then
  chown -R 0:0 "/opt/conga/data/$AGENT_NAME/workspace" 2>/dev/null || true
else
  chown -R 1000:1000 "/opt/conga/data/$AGENT_NAME/data/workspace" 2>/dev/null || true
fi
